# ──────────────────────────────────────────────
#  Backend .gitignore  (Node / Express / MongoDB)
# ──────────────────────────────────────────────

# Environment / secrets — NEVER push these
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# Coverage / test output
coverage/
.nyc_output/

# Misc
*.pem
*.key
*.cert
tmp/
.temp/
