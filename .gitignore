# ============================================================
#  Commute Carbon Carver — Root .gitignore
#  Stack: Node/Express (backend) + React + Vite (frontend)
# ============================================================

# ──────────────────────────────────────────────
#  SECRETS & ENVIRONMENT FILES  ← never push these
# ──────────────────────────────────────────────
.env
.env.*
!.env.example        # allow a sanitised example template
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local

# ──────────────────────────────────────────────
#  NODE MODULES  (both workspaces)
# ──────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ──────────────────────────────────────────────
#  BUILD / DIST OUTPUT
# ──────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ──────────────────────────────────────────────
#  PACKAGE LOCK FILES  (keep package.json, skip locks if preferred)
# ──────────────────────────────────────────────
# Uncomment the lines below ONLY if you want to ignore lock files.
# It is generally recommended to commit lock files for reproducible builds.
# backend/package-lock.json
# frontend/package-lock.json

# ──────────────────────────────────────────────
#  LOGS
# ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
frontend/logs/

# ──────────────────────────────────────────────
#  OS / SYSTEM FILES
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
#  EDITOR & IDE
# ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json   # allow sharing recommended extensions
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ──────────────────────────────────────────────
#  VITE / FRONTEND SPECIFIC
# ──────────────────────────────────────────────
frontend/*.local
frontend/.cache/

# ──────────────────────────────────────────────
#  TESTING & COVERAGE
# ──────────────────────────────────────────────
coverage/
backend/coverage/
frontend/coverage/
*.lcov
.nyc_output/

# ──────────────────────────────────────────────
#  MISC
# ──────────────────────────────────────────────
*.pem
*.key
*.cert
.temp/
tmp/
