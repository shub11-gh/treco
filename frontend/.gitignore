# ──────────────────────────────────────────────
#  Frontend .gitignore  (React + Vite + Tailwind)
# ──────────────────────────────────────────────

# Environment / secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/
.vite/
.cache/

# Vite local config overrides
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Coverage / test output
coverage/
*.lcov
.nyc_output/

# Misc
*.pem
tmp/
.temp/
